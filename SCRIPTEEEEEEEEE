-- [[ ADVANCED RUNTIME SYSTEM (UI BASED) ]]
local hubStartTime = os.time()

local function formatTime(seconds)
    local hours = math.floor(seconds / 3600)
    local mins = math.floor((seconds % 3600) / 60)
    local secs = math.floor(seconds % 60)
    return string.format("%02d:%02d:%02d", hours, mins, secs)
end

task.spawn(function()
    while task.wait(1) do
        -- Get Server Time (Fallback to 0 if game doesn't use DistributedGameTime)
        local serverTime = workspace.DistributedGameTime or 0
        
        -- If DistributedGameTime fails, estimate it from when the script loaded
        if serverTime == 0 then
            serverTime = os.time() - hubStartTime
        end
        
        local hubTime = os.time() - hubStartTime
        RuntimeLabel.Text = "Server: " .. formatTime(serverTime) .. " | Hub: " .. formatTime(hubTime)
    end
end)

-- [[ MOVEMENT SYSTEM (Anti-AntiCheat Safe) ]]
local block = Instance.new("Part")
block.Size = Vector3.new(1, 1, 1)
block.Name = "AtlanticHubTweenBlock"
block.Anchored = true
block.CanCollide = false
block.CanTouch = false
block.Transparency = 1
block.CFrame = CFrame.new(0, -500, 0)
block.Parent = workspace

local lastUpdate = os.clock()
RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    
    local currentTime = os.clock()
    local dt = currentTime - lastUpdate
    lastUpdate = currentTime
    
    if _G.Moving then
        local direction = (block.Position - hrp.Position)
        local distance = direction.Magnitude
        
        -- Max distance we can move this frame based on speed (Stops instant teleport flags)
        local maxStep = _G.GlobalTweenSpeed * dt
        
        if distance > maxStep then
            local moveVector = direction.Unit * maxStep
            -- Move smoothly and look towards target
            hrp.CFrame = CFrame.new(hrp.Position + moveVector, block.Position)
        else
            hrp.CFrame = block.CFrame
        end
        
        -- Minimal noclip to prevent getting stuck
        hrp.CanCollide = false
    end
end)

local function moveTo(targetCFrame)
    block.CFrame = targetCFrame
    _G.Moving = true
end

-- [[ HELPER FUNCTIONS ]]
local function getChests()
    local chests = {}
    for _, v in pairs(Workspace:GetDescendants()) do
        if string.find(v.Name:lower(), "chest") and (v:IsA("Part") or v:IsA("Model") or v:IsA("MeshPart")) then
            if v:IsA("Model") or (v:IsA("BasePart") and v.Size.Magnitude > 0.5) then
                table.insert(chests, v)
            end
        end
    end
    return chests
end

local function getChestPos(chest)
    if not chest or not chest.Parent then return nil end
    if chest:IsA("Model") then
        return chest:GetPivot().Position
    elseif chest:IsA("BasePart") then
        return chest.Position
    end
    return nil
end

local function isChestHit(chest)
    if not chest or not chest.Parent then return true end -- Destroyed/Removed
    
    -- Check Humanoid Health
    local hum = chest:FindFirstChildOfClass("Humanoid") or chest:FindFirstChild("Humanoid", true)
    if hum and hum.Health <= 0 then return true end
    
    -- Check for "Opened" or "Open" values inside the chest
    local opened = chest:FindFirstChild("Opened", true) or chest:FindFirstChild("Open", true)
    if opened then
        if opened:IsA("BoolValue") and opened.Value then return true end
        if opened:IsA("IntValue") and opened.Value == 1 then return true end
    end
    
    -- Check if name changed to opened/broken
    local lowerName = chest.Name:lower()
    if string.find(lowerName, "opened") or string.find(lowerName, "broken") then return true end
    
    return false
end

-- [[ FAST AREA SWEEP (1-Second Expanding Spiral) ]]
local function fastAreaCheck(chest)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return false end
    local hrp = char.HumanoidRootPart
    
    local chestPos = getChestPos(chest)
    if not chestPos then return false end
    
    _G.Moving = false -- Disable default Heartbeat mover so we can manually sweep fast
    local startTime = os.clock()
    
    -- We rapidly sweep the area at the chest to trigger touch/collection in <1 sec
    for i = 1, 20 do
        if isChestHit(chest) or os.clock() - startTime > 1.0 then break end
        
        local angle = i * math.rad(85) -- Rotate 85 degrees each step
        local radius = 0.5 + (i * 0.25) -- Gradually expand outward from center to ensure all hitboxes are touched
        local offset = Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
        
        local targetCFrame = CFrame.new(chestPos + offset, chestPos)
        -- Fast but Lerp'd movement to prevent hard teleport flags
        hrp.CFrame = hrp.CFrame:Lerp(targetCFrame, 0.8)
        
        task.wait(0.05)
    end
    
    return isChestHit(chest)
end

-- [[ AUTO CHEST FARM ]]
task.spawn(function()
    while task.wait(0.5) do
        if _G.AutoChest then
            local chests = getChests()
            StatusLabel.Text = "Status: Found " .. #chests .. " Chests"
            
            for _, chest in ipairs(chests) do
                if not _G.AutoChest then break end
                if chest and chest.Parent and not isChestHit(chest) then
                    local chestPos = getChestPos(chest)
                    if chestPos then
                        StatusLabel.Text = "Status: Moving to " .. chest.Name
                        
                        -- Move to chest using safe Heartbeat method
                        moveTo(CFrame.new(chestPos))
                        
                        -- Wait until we are close to the chest
                        local timeout = os.clock() + 5
                        local char = LocalPlayer.Character
                        while _G.AutoChest and char and char:FindFirstChild("HumanoidRootPart") and os.clock() < timeout do
                            local hrp = char.HumanoidRootPart
                            if (hrp.Position - chestPos).Magnitude < 5 then
                                break
                            end
                            task.wait(0.1)
                        end
                        
                        _G.Moving = false
                        
                        if not _G.AutoChest then break end
                        
                        -- Confirm if we actually hit it just by arriving
                        if isChestHit(chest) then
                            StatusLabel.Text = "Status: Collected " .. chest.Name
                            task.wait(0.2)
                        else
                            -- We arrived but didn't collect, do a fast area sweep!
                            StatusLabel.Text = "Status: Sweeping " .. chest.Name
                            local hit = fastAreaCheck(chest)
                            
                            if hit then
                                StatusLabel.Text = "Status: Confirmed Hit " .. chest.Name
                                task.wait(0.3)
                            else
                                StatusLabel.Text = "Status: Timed Out " .. chest.Name
                                task.wait(0.5)
                            end
                        end
                    end
                end
            end
        end
    end
end)
