-- [[ RUNTIME & FOD TIMER SYSTEM ]]
local FOD_SPAWN_TIME = 4 * 3600

local function formatTime(seconds)
    if seconds < 0 then seconds = 0 end
    local hours = math.floor(seconds / 3600)
    local mins = math.floor((seconds % 3600) / 60)
    local secs = math.floor(seconds % 60)
    return string.format("%02d:%02d:%02d", hours, mins, secs)
end

task.spawn(function()
    while task.wait(1) do
        if EXEC_ID ~= getgenv().AtlanticExecId then break end
        local serverTime = workspace.DistributedGameTime or 0
        local remaining = FOD_SPAWN_TIME - serverTime
        TimerLabel.Text = "Server: " .. formatTime(serverTime) .. " | Next FoD: " .. formatTime(remaining)
        
        if remaining <= 0 then
            TimerLabel.TextColor3 = Color3.fromRGB(50, 255, 50)
        else
            TimerLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
        end
    end
end)

-- [[ DIRECT FLIGHT SYSTEM ]]
local targetCFrame = CFrame.new(0, -500, 0)

local lastUpdate = os.clock()
local heartConn = RunService.Heartbeat:Connect(function()
    if EXEC_ID ~= getgenv().AtlanticExecId then return end
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    
    local currentTime = os.clock()
    local dt = currentTime - lastUpdate
    lastUpdate = currentTime
    
    if _G.AutoChest then
        -- Cancel out gravity so we float
        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        hrp.CanCollide = false
    end
    
    if _G.Moving then
        local currentPos = hrp.Position
        local goalPos = targetCFrame.Position
        
        -- Fly directly to the target in a straight line
        local direction = (goalPos - currentPos)
        local distance = direction.Magnitude
        local maxStep = _G.GlobalTweenSpeed * dt
        
        if distance > maxStep then
            local moveVector = direction.Unit * maxStep
            -- Move directly towards the chest and look at it
            hrp.CFrame = CFrame.new(currentPos + moveVector, goalPos)
        else
            -- Snap exactly when we reach it
            hrp.CFrame = targetCFrame
        end
    end
end)
table.insert(getgenv().AtlanticConnections, heartConn)

local function moveTo(goalCFrame)
    targetCFrame = goalCFrame
    _G.Moving = true
end

-- [[ FOD & SEA BEAST DETECTION ]]
local function hasFistOfDarkness()
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if char and char:FindFirstChild("Fist of Darkness") then return true end
    if backpack and backpack:FindFirstChild("Fist of Darkness") then return true end
    return false
end

local blacklistedChests = {}
local function getChests()
    local chests = {}
    for _, v in pairs(Workspace:GetDescendants()) do
        -- STRICT RULE: Only target Models named exactly "Chest"
        -- This stops it from flying to invisible "ChestDetector" parts in the sky
        if v:IsA("Model") and v.Name == "Chest" then
            if not table.find(blacklistedChests, v) then
                table.insert(chests, v)
            end
        end
    end
    return chests
end

local function getChestPos(chest)
    if not chest or not chest.Parent then return nil end
    -- GetPivot perfectly targets the base of the model on the ground
    if chest:IsA("Model") then
        return chest:GetPivot().Position
    elseif chest:IsA("BasePart") then
        return chest.Position
    end
    return nil
end

local function isChestHit(chest)
    if not chest or not chest.Parent then return true end
    local hum = chest:FindFirstChildOfClass("Humanoid") or chest:FindFirstChild("Humanoid", true)
    if hum and hum.Health <= 0 then return true end
    local opened = chest:FindFirstChild("Opened", true)
    if opened and opened.Value then return true end
    return false
end

local function fastAreaCheck(chest)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return false end
    local hrp = char.HumanoidRootPart
    
    local chestPos = getChestPos(chest)
    if not chestPos then return false end
    
    _G.Moving = false 
    _G.Sweeping = true
    local startTime = os.clock()
    
    for i = 1, 25 do
        if isChestHit(chest) or os.clock() - startTime > 1.5 or hasFistOfDarkness() then break end
        
        local angle = i * math.rad(75)
        local radius = 0.5 + (i * 0.3)
        local yOffset = math.sin(i * 0.5) * 2 
        
        local offset = Vector3.new(math.cos(angle) * radius, yOffset, math.sin(angle) * radius)
        local targetPos = chestPos + offset
        
        hrp.CFrame = hrp.CFrame:Lerp(CFrame.new(targetPos, chestPos), 0.9)
        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        
        task.wait(0.04)
    end
    _G.Sweeping = false
    
    return isChestHit(chest)
end

