-- [[ NOTIFY SERVER RUNTIME ]]
local function formatTime(seconds)
    local hours = math.floor(seconds / 3600)
    local mins = math.floor((seconds % 3600) / 60)
    local secs = math.floor(seconds % 60)
    return string.format("%02d:%02d:%02d", hours, mins, secs)
end

task.spawn(function()
    while task.wait(1) do
        local serverTime = workspace.DistributedGameTime
        print("Server Runtime: " .. formatTime(serverTime))
    end
end)

-- [[ TWEEN MOVEMENT PART ]]
local currentTween = nil
local block = Instance.new("Part", workspace)
block.Size = Vector3.new(1, 1, 1)
block.Name = "AtlanticHubTweenBlock"
block.Anchored = true
block.CanCollide = false
block.CanTouch = false
block.Transparency = 1
block.CFrame = CFrame.new(0, -500, 0)

RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    
    if currentTween and currentTween.PlaybackState == Enum.PlaybackState.Playing then
        if (hrp.Position - block.Position).Magnitude <= 200 then
            hrp.CFrame = block.CFrame
        else
            block.CFrame = hrp.CFrame
        end
        for _, v in pairs(char:GetDescendants()) do
            if v:IsA("BasePart") then v.CanCollide = false end
        end
    end
end)

local function tweenTo(targetCFrame)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart

    local distance = (hrp.Position - targetCFrame.Position).Magnitude
    local timeToTravel = distance / _G.GlobalTweenSpeed

    if currentTween then
        currentTween:Cancel()
    end

    block.CFrame = hrp.CFrame
    local tweenInfo = TweenInfo.new(timeToTravel, Enum.EasingStyle.Linear)
    currentTween = TweenService:Create(block, tweenInfo, {CFrame = targetCFrame})
    currentTween:Play()

    return currentTween
end

-- [[ AUTO CHEST FARM ]]
local function getChests()
    local chests = {}
    for _, v in pairs(Workspace:GetDescendants()) do
        if string.find(v.Name:lower(), "chest") and (v:IsA("Part") or v:IsA("Model")) then
            table.insert(chests, v)
        end
    end
    return chests
end

task.spawn(function()
    while task.wait(0.5) do
        if _G.AutoChest then
            local chests = getChests()
            StatusLabel.Text = "Found " .. #chests .. " Chests"
            
            for _, chest in ipairs(chests) do
                if not _G.AutoChest then break end
                if chest and chest.Parent then
                    local chestCFrame = chest:IsA("Model") and chest:GetPivot() or chest.CFrame
                    local tween = tweenTo(chestCFrame)
                    
                    if tween then
                        tween.Completed:Wait()
                    end
                    task.wait(0.2)
                end
            end
        end
    end
end)
