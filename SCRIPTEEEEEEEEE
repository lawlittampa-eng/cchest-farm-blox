        RuntimeLabel.Text = "Server: " .. formatTime(serverTime) .. " | Hub: " .. formatTime(hubTime)
    end
end)

-- [[ TWEEN MOVEMENT PART ]]
local currentTween = nil
local block = Instance.new("Part", workspace)
block.Size = Vector3.new(1, 1, 1)
block.Name = "AtlanticHubTweenBlock"
block.Anchored = true
block.CanCollide = false
block.CanTouch = false
block.Transparency = 1
block.CFrame = CFrame.new(0, -500, 0)

RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    
    -- Only move player if we are actively tweening or circling
    if _G.Circling or (currentTween and currentTween.PlaybackState == Enum.PlaybackState.Playing) then
        if (hrp.Position - block.Position).Magnitude <= 200 then
            hrp.CFrame = block.CFrame
        else
            block.CFrame = hrp.CFrame
        end
        for _, v in pairs(char:GetDescendants()) do
            if v:IsA("BasePart") then v.CanCollide = false end
        end
    end
end)

local function tweenTo(targetCFrame)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart

    local distance = (hrp.Position - targetCFrame.Position).Magnitude
    local timeToTravel = distance / _G.GlobalTweenSpeed

    if currentTween then
        currentTween:Cancel()
    end

    block.CFrame = hrp.CFrame
    local tweenInfo = TweenInfo.new(timeToTravel, Enum.EasingStyle.Linear)
    currentTween = TweenService:Create(block, tweenInfo, {CFrame = targetCFrame})
    currentTween:Play()

    return currentTween
end

-- [[ HELPER FUNCTIONS ]]
local function getChests()
    local chests = {}
    for _, v in pairs(Workspace:GetDescendants()) do
        if string.find(v.Name:lower(), "chest") and (v:IsA("Part") or v:IsA("Model") or v:IsA("MeshPart")) then
            table.insert(chests, v)
        end
    end
    return chests
end

local function getChestPos(chest)
    if not chest or not chest.Parent then return nil end
    if chest:IsA("Model") then
        return chest:GetPivot().Position
    elseif chest:IsA("BasePart") then
        return chest.Position
    end
    return nil
end

-- Advanced Hit Confirmation
local function isChestHit(chest)
    if not chest or not chest.Parent then return true end -- Destroyed/Removed
    if chest:IsA("Model") then
        local hum = chest:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health <= 0 then return true end
        local opened = chest:FindFirstChild("Opened")
        if opened and opened.Value == true then return true end
    elseif chest:IsA("BasePart") then
        local opened = chest:FindFirstChild("Opened")
        if opened and opened.Value == true then return true end
    end
    return false
end

-- Generic Attack Function
local function attack()
    local char = LocalPlayer.Character
    if not char then return end
    local tool = char:FindFirstChildOfClass("Tool")
    if tool then
        pcall(function() tool:Activate() end)
    end
    pcall(function() 
        if mouse1click then 
            mouse1click() 
        else
            local VirtualInputManager = game:GetService("VirtualInputManager")
            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
        end
    end)
end

-- Circling Logic
local function circleAndAttack(chest)
    _G.Circling = true
    local radius = 8
    local angle = 0
    local timeout = os.time() + 15 -- Timeout after 15 seconds of circling to prevent infinite loops
    
    while _G.AutoChest and not isChestHit(chest) and os.time() < timeout do
        local center = getChestPos(chest)
        if center then
            angle = angle + math.rad(60)
            local targetPos = center + Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
            block.CFrame = CFrame.new(targetPos, center) -- Look at center while circling
            attack()
        else
            break
        end
        task.wait(0.3)
    end
    
    _G.Circling = false
end

-- [[ AUTO CHEST FARM ]]
task.spawn(function()
    while task.wait(0.5) do
        if _G.AutoChest then
            local chests = getChests()
            StatusLabel.Text = "Status: Found " .. #chests .. " Chests"
            
            for _, chest in ipairs(chests) do
                if not _G.AutoChest then break end
                if chest and chest.Parent and not isChestHit(chest) then
                    local chestCFrame = chest:IsA("Model") and chest:GetPivot() or chest.CFrame
                    StatusLabel.Text = "Status: Moving to " .. chest.Name
                    
                    local tween = tweenTo(chestCFrame)
                    local completed = false
                    
                    if tween then
                        local connection = tween.Completed:Connect(function()
                            completed = true
                        end)
                        
                        -- Wait for tween to complete or chest to be destroyed/already hit
                        while not completed and chest.Parent and _G.AutoChest and not isChestHit(chest) do
                            task.wait(0.1)
                        end
                        connection:Disconnect()
                    end
                    
                    -- If we arrived but didn't hit it, circle and attack
                    if chest and chest.Parent and _G.AutoChest and not isChestHit(chest) then
                        if currentTween then currentTween:Cancel() end
                        StatusLabel.Text = "Status: Circling " .. chest.Name
                        circleAndAttack(chest)
                        
                        if isChestHit(chest) then
                            StatusLabel.Text = "Status: Confirmed Hit " .. chest.Name
                            task.wait(0.5)
                        else
                            StatusLabel.Text = "Status: Timed out on " .. chest.Name
                            task.wait(0.5)
                        end
                    elseif chest and not chest.Parent then
                        StatusLabel.Text = "Status: Destroyed " .. chest.Name
                        task.wait(0.5)
                    end
                end
            end
        end
    end
end)
